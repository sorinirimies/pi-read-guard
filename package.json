  "license": "MIT",
  "author": "sorinirimies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/pi-read-guard.git"
  },
  "homepage": "https://github.com/sorinirimies/pi-read-guard#readme",
  "files": ["extensions", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/read-guard.ts"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "nu scripts/ci/quality_gate.nu"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
